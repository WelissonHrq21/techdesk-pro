NODE_ENV=development
PORT=3333
API_PORT=3333
FRONTEND_PORT=8081

POSTGRES_DB=techdesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password

DATABASE_URL="postgresql://postgres:change-this-postgres-password@postgres:5432/techdesk?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@127.0.0.1:5433/techdesk_test?schema=public"

JWT_SECRET="change-this-secret-with-at-least-thirty-two-characters"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="https://app.example.com"
SWAGGER_ENABLED=false
LOG_LEVEL="info"
VITE_API_URL="https://api.example.com"

ADMIN_NAME="Admin"
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="change-this-admin-password"
