#!/bin/sh
set -eu

DEPLOY_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "${DEPLOY_ROOT}/setup-core.sh"

load_observability() {
  . "${DEPLOY_ROOT}/observability.sh"
}

load_backup_contracts() {
  load_observability
  . "${DEPLOY_ROOT}/backup-contracts.sh"
}

load_operational_contracts() {
  load_observability
  . "${DEPLOY_ROOT}/operational-contracts.sh"
}

usage() {
  cat <<EOF
TechDesk Pro Setup

Uso:
  ./techdesk install [--port 8080] [--version X.Y.Z] [--non-interactive --admin-password SENHA]
  ./techdesk status
  ./techdesk status --json
  ./techdesk diagnostics --json
  ./techdesk backup-list --json
  ./techdesk backup --json
  ./techdesk backup-check --id BACKUP_ID --json
  ./techdesk restore-check --id BACKUP_ID --json
  ./techdesk restart --target stack --json
  ./techdesk repair --json
  ./techdesk restart
  ./techdesk repair
  ./techdesk backup
  ./techdesk restore-check caminho/do/backup.dump [sha256-esperado]
  ./techdesk upgrade --version X.Y.Z

Producao oficial: Ubuntu Server LTS com Docker Engine e Docker Compose Plugin.
Windows permanece best effort via scripts PowerShell existentes.

No Linux, o install prepara o runtime permanente em /opt/techdesk-pro por
padrao. Depois do install, use /opt/techdesk-pro/techdesk ou o symlink
/usr/local/bin/techdesk quando criado manualmente pelo operador.
EOF
}

require_env() {
  if [ ! -f "$ENV_FILE" ]; then
    fail ".env nao encontrado. Use install primeiro."
    return 1
  fi
}

prompt_default() {
  label="$1"
  default="$2"
  printf '%s [%s]: ' "$label" "$default" >&2
  read -r value
  value="${value:-$default}"
  printf '%s' "$value"
}

prompt_password() {
  printf '%s' "Senha do ADMIN inicial: " >&2
  stty -echo 2>/dev/null || true
  read -r value
  stty echo 2>/dev/null || true
  printf '\n' >&2
  printf '%s' "$value"
}

install_cmd() {
  port="$DEFAULT_PORT"
  target_version="$DEFAULT_VERSION"
  admin_name="Administrador"
  admin_login="admin"
  admin_password=""
  non_interactive=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --port)
        port="${2:-}"; shift 2 ;;
      --version)
        target_version="${2:-}"; shift 2 ;;
      --admin-name)
        admin_name="${2:-}"; shift 2 ;;
      --admin-login)
        admin_login="${2:-}"; shift 2 ;;
      --admin-password)
        admin_password="${2:-}"; shift 2 ;;
      --non-interactive)
        non_interactive=1; shift ;;
      *)
        fail "Opcao desconhecida para install: $1"; return 2 ;;
    esac
  done

  require_operation_access install || return 1
  setup_log_init
  trap 'say "Instalacao interrompida. Dados e arquivos existentes foram preservados."; exit 130' INT TERM

  state="$(detect_installation_state)"
  if [ "$state" != "NOT_INSTALLED" ]; then
    say "TechDesk Pro ja possui sinais de instalacao: ${state}."
    say "Use status, repair ou upgrade. INSTALL nao executa acao destrutiva."
    return 1
  fi

  if [ "$non_interactive" -eq 0 ]; then
    port="$(prompt_default "Porta de acesso do TechDesk Pro" "$port")"
    admin_name="$(prompt_default "Nome do ADMIN inicial" "$admin_name")"
    admin_login="$(prompt_default "Login do ADMIN inicial" "$admin_login")"
    admin_password="$(prompt_password)"
  fi

  if [ -z "$admin_password" ] || [ "${#admin_password}" -lt 6 ]; then
    fail "A senha do ADMIN precisa ter pelo menos 6 caracteres."
    return 2
  fi

  if ! semver_is_valid "$target_version"; then
    fail "Versao alvo invalida ou desconhecida: ${target_version}. Use X.Y.Z ou X.Y.Z-rc.N, por exemplo 1.1.1." || true
    return 2
  fi

  preflight install "$port" || return 10

  say "[2/8] Preparando configuracao persistente..."
  mkdir -p "$LOG_DIR" "$BACKUP_DIR"
  write_env_file "$port" "$admin_name" "$admin_login" "$admin_password" "$target_version" "$DEFAULT_PROJECT_NAME"
  ensure_env_permissions
  say "OK: configuracao criada. Secrets nao foram exibidos."

  say "[3/8] Baixando imagens..."
  validate_compose_config || return 20
  run_logged "compose pull" compose pull || return 20

  say "[4/8] Iniciando banco..."
  run_logged "compose up postgres" compose up -d postgres || return 30

  say "[5/8] Aplicando migrations e iniciando API..."
  run_logged "compose up api" compose up -d api || return 40

  say "[6/8] Iniciando frontend..."
  run_logged "compose up frontend" compose up -d frontend || return 50

  say "[7/8] Verificando health/ready/smoke..."
  if ! wait_for_ready 120; then
    compose ps 2>&1 | redact >> "$SETUP_LOG_FILE" || true
    compose logs --tail 120 api 2>&1 | redact >> "$SETUP_LOG_FILE" || true
    fail "TechDesk Pro nao ficou healthy/ready dentro do timeout."
    return 60
  fi
  run_logged "seed admin" compose exec -T api node /app/deploy/seed-admin.js || return 70
  wait_for_ready 60 || return 60

  say "[8/8] Finalizando..."
  if ! write_metadata "$target_version"; then
    fail "Metadata de instalacao nao foi persistida. Instalacao marcada como parcial; dados e containers foram preservados." || true
    return 90
  fi
  ensure_env_permissions
  say "TechDesk Pro instalado com sucesso."
  say "Versao: ${target_version}"
  say "Runtime permanente: ${DEPLOY_ROOT}"
  say "Status: Healthy"
  show_urls
  say "Proximo passo: abra a URL acima para configurar o TechDesk Pro."
}

status_cmd() {
  if [ "$#" -eq 1 ] && [ "$1" = "--json" ]; then
    load_observability
    contract_status_cmd
    return
  fi
  if [ "$#" -ne 0 ]; then
    fail "Opcao desconhecida para status: $1"
    return 2
  fi
  state="$(detect_installation_state)"
  version="$(current_version)"
  port="$(techdesk_port)"
  docker_state="$(docker_access_state)"

  echo "TechDesk Pro"
  echo ""
  echo "Version: ${version}"
  version_diagnostics || true
  echo "Installation: ${state}"
  echo "Runtime: ${DEPLOY_ROOT}"
  echo "Env: ${ENV_FILE}"
  echo "Metadata: ${METADATA_FILE}"
  echo "Logs: ${LOG_DIR}"
  echo "Backups: ${BACKUP_DIR}"
  case "$docker_state" in
    RUNNING)
      echo "Docker: running"
      ;;
    PERMISSION_DENIED)
      echo "Docker: permission denied"
      echo "WARNING: sem acesso ao Docker socket; verifique o grupo docker ou use sudo para diagnosticos de containers."
      ;;
    UNAVAILABLE)
      echo "Docker: installed but unavailable"
      ;;
    *)
      echo "Docker: not installed"
      ;;
  esac
  if docker_available && compose_available; then
    echo "Compose: available"
  else
    echo "Compose: unavailable"
  fi

  if [ "$docker_state" = "RUNNING" ]; then
    show_container_status
  fi

  if frontend_responds; then
    echo "Frontend: healthy"
    echo "Health: OK"
  else
    echo "Frontend: unhealthy"
    echo "Health: ERROR"
  fi

  if api_ready; then
    echo "API: ready"
    echo "Ready: OK"
  else
    echo "API: not ready"
    echo "Ready: ERROR"
  fi

  echo ""
  show_urls

  if [ "$state" = "INSTALLED_HEALTHY" ]; then
    version_diagnostics >/dev/null 2>&1 || return 1
    return 0
  fi
  return 1
}

diagnostics_cmd() {
  if [ "$#" -ne 1 ] || [ "$1" != "--json" ]; then
    fail "Use diagnostics --json. Diagnostics estruturado e somente leitura."
    return 2
  fi
  load_observability
  contract_diagnostics_cmd
}

backup_list_cmd() {
  if [ "$#" -ne 1 ] || [ "$1" != "--json" ]; then
    fail "Use backup-list --json. A listagem e somente leitura."
    return 2
  fi
  load_observability
  contract_backup_list_cmd
}

backup_cmd() {
  if [ "$#" -eq 1 ] && [ "$1" = "--json" ]; then
    load_backup_contracts
    contract_backup_cmd
    return
  fi
  if [ "$#" -ne 0 ]; then
    fail "Use backup ou backup --json."
    return 2
  fi
  require_operation_access backup || return 1
  setup_log_init
  require_env
  tmp="${LOG_DIR}/backup-command-$$.tmp"
  "${DEPLOY_ROOT}/backup.sh" >"$tmp" 2>&1 || {
    code="$?"
    redact < "$tmp" | tee -a "$SETUP_LOG_FILE" >&2
    rm -f "$tmp"
    return "$code"
  }
  redact < "$tmp" | tee -a "$SETUP_LOG_FILE"
  rm -f "$tmp"
}

backup_check_cmd() {
  if [ "$#" -ne 3 ] || [ "$1" != "--id" ] || [ "$3" != "--json" ]; then
    fail "Use backup-check --id BACKUP_ID --json."
    return 2
  fi
  load_backup_contracts
  contract_backup_check_cmd "$2"
}

restore_check_cmd() {
  if [ "$#" -eq 3 ] && [ "$1" = "--id" ] && [ "$3" = "--json" ]; then
    load_backup_contracts
    contract_restore_check_cmd "$2"
    return
  fi
  if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    fail "Use restore-check caminho/do/backup.dump [sha256] ou restore-check --id BACKUP_ID --json."
    return 2
  fi
  require_operation_access restore-check || return 1
  setup_log_init
  require_env
  tmp="${LOG_DIR}/restore-check-command-$$.tmp"
  "${DEPLOY_ROOT}/restore-check.sh" "$@" >"$tmp" 2>&1 || {
    code="$?"
    redact < "$tmp" | tee -a "$SETUP_LOG_FILE" >&2
    rm -f "$tmp"
    return "$code"
  }
  redact < "$tmp" | tee -a "$SETUP_LOG_FILE"
  rm -f "$tmp"
}

restart_stack_run() {
  require_operation_access restart || return 11
  setup_log_init
  trap 'say "Restart interrompido. O estado real deve ser verificado antes de nova tentativa."; exit 130' INT TERM
  require_env || return 12
  run_logged "restart stack" "${DEPLOY_ROOT}/restart.sh" || {
    restart_exit="$?"
    return "$restart_exit"
  }
}

restart_cmd() {
  if [ "$#" -eq 3 ] && [ "$1" = "--target" ] && [ "$2" = "stack" ] && [ "$3" = "--json" ]; then
    load_operational_contracts
    contract_restart_stack_cmd
    return
  fi
  if [ "$#" -ne 0 ]; then
    fail "Use restart ou restart --target stack --json."
    return 2
  fi
  restart_stack_run
}

repair_run() {
  require_operation_access repair || return 11
  setup_log_init
  trap 'say "Repair interrompido. Nenhuma limpeza destrutiva foi executada."; exit 130' INT TERM
  require_env || return 12
  preflight repair "$(techdesk_port)" || return 10

  state="$(detect_installation_state)"
  if [ "$state" = "NOT_INSTALLED" ]; then
    fail "Nada para reparar. Execute install."
    return 13
  fi

  say "Repair nao destrutivo iniciado. Volumes e banco serao preservados."
  validate_compose_config || return 20
  run_logged "compose pull" compose pull || return 20
  run_logged "compose up" compose up -d || return 30
  if ! wait_for_ready 120; then
    compose ps 2>&1 | redact >> "$SETUP_LOG_FILE" || true
    compose logs --tail 120 api 2>&1 | redact >> "$SETUP_LOG_FILE" || true
    fail "Repair executado, mas health/ready ainda falhou."
    return 60
  fi
  run_logged "seed admin idempotent" compose exec -T api node /app/deploy/seed-admin.js || true

  repair_version="$(current_version)"
  if [ "$(metadata_value version "")" = "" ]; then
    say "Metadata ausente; validando fontes de versao antes de reconstruir."
    repair_version="$(coherent_recovery_version)" || return 90
  fi
  if [ "$repair_version" = "UNKNOWN" ]; then
    fail "Unable to determine installed TechDesk version. Repair nao reconstruira metadata ambigua." || true
    return 90
  fi
  if ! write_metadata "$repair_version" "$(metadata_value lastUpgradeAt "")"; then
    fail "Metadata de instalacao nao foi persistida apos repair." || true
    return 90
  fi
  ensure_env_permissions
  say "Repair concluido. TechDesk Pro healthy/ready."
  show_urls
}

repair_cmd() {
  if [ "$#" -eq 1 ] && [ "$1" = "--json" ]; then
    load_operational_contracts
    contract_repair_cmd
    return
  fi
  if [ "$#" -ne 0 ]; then
    fail "Use repair ou repair --json."
    return 2
  fi
  repair_run
}

upgrade_cmd() {
  target_version=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --version)
        target_version="${2:-}"; shift 2 ;;
      *)
        fail "Opcao desconhecida para upgrade: $1"; return 2 ;;
    esac
  done

  require_operation_access upgrade 1 || return 1
  setup_log_init
  trap 'say "Upgrade interrompido. Backup/env/banco existentes foram preservados; consulte logs antes de nova tentativa."; exit 130' INT TERM
  require_env

  if [ -z "$target_version" ]; then
    fail "Informe --version X.Y.Z."
    return 2
  fi

  state="$(detect_installation_state)"
  if [ "$state" = "NOT_INSTALLED" ] || [ "$state" = "PARTIAL_INSTALLATION" ]; then
    fail "Upgrade exige instalacao detectada e nao parcial. Estado atual: ${state}."
    return 1
  fi

  current="$(current_version)"
  if [ "$current" = "UNKNOWN" ]; then
    fail "Unable to determine installed TechDesk version. Upgrade bloqueado." || true
    return 2
  fi
  version_class="$(semver_upgrade_classification "$target_version" "$current")"
  if [ "$version_class" = "INVALID_VERSION" ]; then
    fail "invalid SemVer: ${target_version}. Use X.Y.Z, por exemplo 1.1.0."
    return 2
  fi
  if [ "$version_class" = "INVALID_CURRENT_VERSION" ]; then
    fail "Versao atual invalida na instalacao: ${current}."
    return 2
  fi
  if [ "$version_class" = "SAME_VERSION" ]; then
    fail "Versao alvo igual a atual (${current}); nao e upgrade."
    return 2
  fi
  if [ "$version_class" = "DOWNGRADE" ]; then
    fail "Downgrade automatico nao e suportado. Use disaster recovery/restore apropriado."
    return 2
  fi

  preflight upgrade "$(techdesk_port)" || return 10

  say "Upgrade ${current} -> ${target_version}"
  say "Backup pre-upgrade obrigatorio..."
  run_logged "backup pre-upgrade" "${DEPLOY_ROOT}/backup.sh" || {
    fail "Backup/validacao falhou. Upgrade abortado antes de trocar imagens."
    return 80
  }

  say "Baixando imagens alvo..."
  run_logged "docker pull api target" docker pull "ghcr.io/welissonhrq21/techdesk-pro-api:${target_version}" || return 20
  run_logged "docker pull frontend target" docker pull "ghcr.io/welissonhrq21/techdesk-pro-frontend:${target_version}" || return 20

  say "Atualizando configuracao de imagens..."
  apply_target_images "$target_version"
  ensure_env_permissions

  say "Aplicando upgrade via Compose..."
  validate_compose_config || return 20
  run_logged "compose up target" compose up -d || return 40

  say "Verificando health/ready/smoke..."
  if ! wait_for_ready 120; then
    compose ps 2>&1 | redact >> "$SETUP_LOG_FILE" || true
    compose logs --tail 120 api 2>&1 | redact >> "$SETUP_LOG_FILE" || true
    fail "Upgrade aplicado parcialmente, mas health/ready falhou. Backup foi preservado; downgrade automatico nao sera executado."
    return 60
  fi

  if ! write_metadata "$target_version" "$(setup_timestamp)"; then
    fail "Metadata de upgrade nao foi persistida. Upgrade aplicado parcialmente; backup foi preservado." || true
    return 90
  fi
  ensure_env_permissions
  say "Upgrade concluido com sucesso."
  show_urls
}

self_test_cmd() {
  setup_log_init
  self_test_setup_core
  echo "setup self-test: PASS"
}

command="${1:-}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command" in
  install|status|diagnostics|backup-list|restart|repair|backup|backup-check|restore-check|upgrade)
    ensure_or_delegate_runtime "$command" "$@"
    ;;
esac

case "$command" in
  install) install_cmd "$@" ;;
  status) status_cmd "$@" ;;
  diagnostics) diagnostics_cmd "$@" ;;
  backup-list) backup_list_cmd "$@" ;;
  restart) restart_cmd "$@" ;;
  repair) repair_cmd "$@" ;;
  backup) backup_cmd "$@" ;;
  backup-check) backup_check_cmd "$@" ;;
  restore-check) restore_check_cmd "$@" ;;
  upgrade) upgrade_cmd "$@" ;;
  --self-test) self_test_cmd ;;
  ""|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
